# ============================================================================
# Edionic — 100% Free Cloud AI Brain Configuration (.env.example)
# Copy this file to `.env` if you want to enable optional Free Cloud LLM keys.
# NO CREDIT CARD OR PAYMENT IS REQUIRED FOR ANY OF THESE KEYS!
# Even if you leave these empty, Edionic's Built-in 10-Agent Bilingual Crew
# Engine works 100% free & offline out of the box.
# ============================================================================

# 1. Groq Cloud Free API Key (14,400 free requests/day — llama-3.3-70b-versatile)
# Get free key (no card): https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini Free API Key (1,500 free requests/day — gemini-2.0-flash)
# Get free key (no card): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. Optional Local Ollama (if running on PC)
EDIONIC_OLLAMA_URL=http://127.0.0.1:11434
EDIONIC_OLLAMA_MODEL=llama3.2:3b

# 4. Server Host & Port (7860 for Hugging Face Spaces, 8080 for local)
EDIONIC_HOST=0.0.0.0
EDIONIC_PORT=8080
